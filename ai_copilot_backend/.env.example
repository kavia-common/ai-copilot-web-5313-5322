# Example environment variables for AI Copilot Backend

# Your Google Gemini API key (required)
# Obtain from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_actual_api_key_here

# Optional: Override the Gemini model to use.
# Defaults to "gemini-1.5-pro" if not set.
GEMINI_MODEL=gemini-1.5-pro
