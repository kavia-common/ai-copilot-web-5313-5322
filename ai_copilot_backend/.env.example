# Copy this file to .env and fill in values as needed.

# Required: Google Gemini API key
GEMINI_API_KEY=

# Optional: Model to use (default is gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# CORS configuration for the FastAPI backend
# Comma-separated list of exact origins allowed to call the API.
# Typically set to your frontend URLs.
# Example: http://localhost:3000,https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://vscode-internal-38099-beta.beta01.cloud.kavia.ai:3000

# Optional: Regex to allow origin patterns. If left blank, a safe default
# is used that allows localhost and the current deployment domain.
# CORS_ALLOW_ORIGIN_REGEX=
