# Environment variables for AI Copilot Backend

# Your Google Gemini API key (required)
# Obtain from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_actual_api_key_here

# Gemini model to use (optional, defaults to gemini-1.5-flash if not set)
# Examples: gemini-1.5-flash, gemini-1.5-pro, gemini-1.0-pro
GEMINI_MODEL=gemini-1.5-flash
