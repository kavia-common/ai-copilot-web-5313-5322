# PUBLIC_INTERFACE
# Google Gemini API key (required for /api/chat)
GEMINI_API_KEY=your_gemini_api_key_here

# PUBLIC_INTERFACE
# Optional: Override the default CORS regex, or list exact origins via CORS_ALLOWED_ORIGINS
# Comma-separated list of exact origins:
#CORS_ALLOWED_ORIGINS=https://vscode-internal-32145-beta.beta01.cloud.kavia.ai:3000,https://vscode-internal-35991-beta.beta01.cloud.kavia.ai:3000,https://your-frontend.example.com

# PUBLIC_INTERFACE
# Regex to allow origins (if provided, used by backend)
# Defaults already allow localhost and *.cloud.kavia.ai and specific backend ALB:
#CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^https://vscode-internal-38099-beta\.beta01\.cloud\.kavia\.ai(:\d+)?$|^https://kavia-alb-d1caf850-1598685687\.backend\.kavia\.app$|^https://kavia-alb-2474e9cb-881246245\.backend\.kavia\.app$
